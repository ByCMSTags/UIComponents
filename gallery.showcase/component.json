            "en": "Place",
            "ar": "المكان"
          },
          "localized": true
        },
        {
          "key": "buttonText",
          "type": "shortText",
          "label": {
            "en": "Button text (shows a button instead)",
            "ar": "نص الزر (يظهر زر بدلًا من الاسم)"
          },
          "localized": true
        },
        {
          "key": "link",
          "type": "shortText",
          "label": {
            "en": "Button link",
            "ar": "رابط الزر"
          }
        }
      ]
    }
