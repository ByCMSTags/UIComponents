{
  "id": "account.items",
  "version": "1.0.0",
  "category": "account",
  "kind": "single",
  "name": {
    "en": "My content (add and edit)",
    "ar": "محتواي (إضافة وتعديل)"
  },
  "description": {
    "en": "The signed-in visitor's own records in one collection, with a form built from the fields marked \"Writable through the API\". Set the collection under Collection > Website accounts.",
    "ar": "سجلات الزائر المسجّل في مجموعة واحدة، مع نموذج يُبنى من الحقول المعلَّمة «قابل للكتابة عبر API». فعّل المجموعة من إعداد «حسابات الموقع» فيها."
  },
  "fields": [
    {
      "key": "title",
      "type": "shortText",
      "label": {
        "en": "Title",
        "ar": "العنوان"
      },
      "localized": true,
      "aliases": [
        "heading",
        "headline"
      ]
    },
    {
      "key": "text",
      "type": "longText",
      "label": {
        "en": "Text",
        "ar": "النص"
      },
      "localized": true,
      "aliases": [
        "intro",
        "description",
        "body"
      ]
    },
    {
      "key": "collection",
      "type": "shortText",
      "label": {
        "en": "Collection",
        "ar": "المجموعة"
      },
      "helpText": {
        "en": "Slug of the collection visitors add to, e.g. projects.",
        "ar": "رابط المجموعة التي يضيف إليها الزوار، مثل projects."
      },
      "aliases": [
        "collectionSlug",
        "slug"
      ]
    },
    {
      "key": "signinPage",
      "type": "shortText",
      "label": {
        "en": "Sign-in page",
        "ar": "صفحة تسجيل الدخول"
      },
      "helpText": {
        "en": "Slug of the page with the sign-in section, e.g. login.",
        "ar": "رابط الصفحة التي فيها قسم الدخول، مثل login."
      },
      "aliases": [
        "loginPage"
      ]
    }
  ],
  "defaults": {
    "signinPage": "login"
  },
  "placeholders": [
    {
      "token": "{{title}}",
      "field": "title",
      "type": "shortText",
      "label": {
        "en": "Title",
        "ar": "العنوان"
      }
    },
    {
      "token": "{{text}}",
      "field": "text",
      "type": "longText",
      "label": {
        "en": "Text",
        "ar": "النص"
      }
    },
    {
      "token": "{{collection}}",
      "field": "collection",
      "type": "shortText",
      "label": {
        "en": "Collection",
        "ar": "المجموعة"
      }
    },
    {
      "token": "{{signinPage}}",
      "field": "signinPage",
      "type": "shortText",
      "label": {
        "en": "Sign-in page",
        "ar": "صفحة تسجيل الدخول"
      }
    }
  ]
}
