{
  "id": "gallery.panels",
  "category": "gallery",
  "kind": "single",
  "name": {
    "en": "Photo panels",
    "ar": "ألواح صور"
  },
  "description": {
    "en": "A full-width strip of photos with arrows. A photo that has text opens as a white card.",
    "ar": "شريط صور بعرض الصفحة مع أسهم. الصورة التي معها نص تُفتح كبطاقة بيضاء."
  },
  "fields": [
    {
      "key": "prevIcon",
      "type": "icon",
      "label": {
        "en": "Previous icon",
        "ar": "أيقونة السابق"
      },
      "placeholder": "fi-rr-angle-small-left"
    },
    {
      "key": "nextIcon",
      "type": "icon",
      "label": {
        "en": "Next icon",
        "ar": "أيقونة التالي"
      },
      "placeholder": "fi-rr-angle-small-right"
    },
    {
      "key": "items",
      "type": "repeater",
      "label": {
        "en": "Panels",
        "ar": "الألواح"
      },
      "aliases": [
        "projects",
        "cases",
        "highlights",
        "gallery",
        "list",
        "cards",
        "entries",
        "rows",
        "slides",
        "photos"
      ],
      "subFields": [
        {
          "key": "title",
          "type": "shortText",
          "label": {
            "en": "Title",
            "ar": "العنوان"
          },
          "localized": true,
          "required": true,
          "aliases": [
            "titel",
            "heading",
            "headline",
            "name",
            "label",
            "caption"
          ]
        },
        {
          "key": "description",
          "type": "longText",
          "label": {
            "en": "Text",
            "ar": "النص"
          },
          "localized": true,
          "aliases": [
            "body",
            "text",
            "content",
            "desc",
            "summary",
            "excerpt",
            "details",
            "lead",
            "intro",
            "paragraph"
          ]
        },
        {
          "key": "image",
          "type": "image",
          "label": {
            "en": "Image",
            "ar": "الصورة"
          },
          "aliases": [
            "photo",
            "imges",
            "imegs",
            "images",
            "img",
            "picture",
            "cover",
            "media"
          ]
        }
      ]
    }
  ],
  "version": "1.0.0",
  "placeholders": [
    {
      "token": "{{items}}",
      "field": "items",
      "type": "repeater",
      "label": {
        "en": "Panels",
        "ar": "الألواح"
      }
    },
    {
      "token": "{{#items}}",
      "field": "items",
      "type": "repeater",
      "role": "open"
    },
    {
      "token": "{{/items}}",
      "field": "items",
      "type": "repeater",
      "role": "close"
    },
    {
      "token": "{{title}}",
      "field": "items.title",
      "type": "shortText",
      "label": {
        "en": "Title",
        "ar": "العنوان"
      },
      "scope": "items"
    },
    {
      "token": "{{description}}",
      "field": "items.description",
      "type": "longText",
      "label": {
        "en": "Text",
        "ar": "النص"
      },
      "scope": "items"
    },
    {
      "token": "{{image}}",
      "field": "items.image",
      "type": "image",
      "label": {
        "en": "Image",
        "ar": "الصورة"
      },
      "scope": "items"
    }
  ]
}
