{
  "id": "faq.accordion",
  "category": "faq",
  "kind": "single",
  "name": {
    "en": "Questions and answers",
    "ar": "أسئلة وأجوبة"
  },
  "description": {
    "en": "Questions that open to show their answer.",
    "ar": "أسئلة تنفتح لتظهر أجوبتها."
  },
  "fields": [
    {
      "key": "heading",
      "type": "shortText",
      "label": {
        "en": "Heading",
        "ar": "العنوان"
      },
      "localized": true,
      "aliases": [
        "title",
        "titel",
        "headline",
        "MainHeading",
        "name",
        "eyebrow"
      ]
    },
    {
      "key": "lead",
      "type": "longText",
      "label": {
        "en": "Introduction",
        "ar": "المقدمة"
      },
      "localized": true,
      "aliases": [
        "description",
        "body",
        "subtitle",
        "intro",
        "text",
        "leadleft",
        "summary"
      ]
    },
    {
      "key": "items",
      "type": "repeater",
      "label": {
        "en": "Questions",
        "ar": "الأسئلة"
      },
      "aliases": [
        "questions",
        "faq",
        "highlights",
        "services",
        "group",
        "groub",
        "list",
        "cards",
        "features",
        "steps",
        "points",
        "tags",
        "rates",
        "members",
        "plans",
        "testimonials",
        "reviews",
        "entries",
        "rows",
        "body"
      ],
      "subFields": [
        {
          "key": "question",
          "type": "shortText",
          "label": {
            "en": "Question",
            "ar": "السؤال"
          },
          "localized": true,
          "aliases": [
            "title",
            "name"
          ]
        },
        {
          "key": "answer",
          "type": "longText",
          "label": {
            "en": "Answer",
            "ar": "الجواب"
          },
          "localized": true,
          "aliases": [
            "text",
            "description",
            "body"
          ]
        }
      ]
    }
  ],
  "version": "1.0.0",
  "placeholders": [
    {
      "token": "{{heading}}",
      "field": "heading",
      "type": "shortText",
      "label": {
        "en": "Heading",
        "ar": "العنوان"
      }
    },
    {
      "token": "{{lead}}",
      "field": "lead",
      "type": "longText",
      "label": {
        "en": "Introduction",
        "ar": "المقدمة"
      }
    },
    {
      "token": "{{items}}",
      "field": "items",
      "type": "repeater",
      "label": {
        "en": "Questions",
        "ar": "الأسئلة"
      }
    },
    {
      "token": "{{#items}}",
      "field": "items",
      "type": "repeater",
      "role": "open"
    },
    {
      "token": "{{/items}}",
      "field": "items",
      "type": "repeater",
      "role": "close"
    },
    {
      "token": "{{question}}",
      "field": "items.question",
      "type": "shortText",
      "label": {
        "en": "Question",
        "ar": "السؤال"
      },
      "scope": "items"
    },
    {
      "token": "{{answer}}",
      "field": "items.answer",
      "type": "longText",
      "label": {
        "en": "Answer",
        "ar": "الجواب"
      },
      "scope": "items"
    }
  ]
}
