{
  "id": "logos.orchid",
  "category": "logos",
  "kind": "single",
  "name": {
    "en": "Orchid clients slider",
    "ar": "شريط العملاء المتحرك (أوركيد)"
  },
  "description": {
    "en": "A title, a highlighted line and text, then small cards with a logo or photo and a name that slide by themselves, with round arrow buttons.",
    "ar": "عنوان وسطر بارز ونص، ثم بطاقات صغيرة بشعار أو صورة واسم تتحرك تلقائياً، مع أزرار أسهم دائرية."
  },
  "fields": [
    {
      "key": "title",
      "type": "shortText",
      "label": {
        "en": "Title",
        "ar": "العنوان"
      },
      "localized": true
    },
    {
      "key": "highlight",
      "type": "shortText",
      "label": {
        "en": "Highlighted line",
        "ar": "السطر البارز"
      },
      "localized": true
    },
    {
      "key": "description",
      "type": "longText",
      "label": {
        "en": "Text",
        "ar": "النص"
      },
      "localized": true
    },
    {
      "key": "items",
      "type": "repeater",
      "label": {
        "en": "Clients",
        "ar": "العملاء"
      },
      "localized": true,
      "subFields": [
        {
          "key": "image",
          "type": "image",
          "label": {
            "en": "Logo or photo",
            "ar": "الشعار أو الصورة"
          }
        },
        {
          "key": "title",
          "type": "shortText",
          "label": {
            "en": "Name",
            "ar": "الاسم"
          },
          "localized": true
        }
      ]
    }
  ],
  "version": "1.0.0",
  "placeholders": [
    {
      "token": "{{title}}",
      "field": "title",
      "type": "shortText",
      "label": {
        "en": "Title",
        "ar": "العنوان"
      }
    },
    {
      "token": "{{highlight}}",
      "field": "highlight",
      "type": "shortText",
      "label": {
        "en": "Highlighted line",
        "ar": "السطر البارز"
      }
    },
    {
      "token": "{{description}}",
      "field": "description",
      "type": "longText",
      "label": {
        "en": "Text",
        "ar": "النص"
      }
    },
    {
      "token": "{{items}}",
      "field": "items",
      "type": "repeater",
      "label": {
        "en": "Clients",
        "ar": "العملاء"
      }
    },
    {
      "token": "{{#items}}",
      "field": "items",
      "type": "repeater",
      "role": "open"
    },
    {
      "token": "{{/items}}",
      "field": "items",
      "type": "repeater",
      "role": "close"
    },
    {
      "token": "{{image}}",
      "field": "items.image",
      "type": "image",
      "label": {
        "en": "Logo or photo",
        "ar": "الشعار أو الصورة"
      },
      "scope": "items"
    },
    {
      "token": "{{title}}",
      "field": "items.title",
      "type": "shortText",
      "label": {
        "en": "Name",
        "ar": "الاسم"
      },
      "scope": "items"
    }
  ]
}
