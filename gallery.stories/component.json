{
  "id": "gallery.stories",
  "category": "gallery",
  "kind": "single",
  "name": {
    "en": "News cards carousel",
    "ar": "دوار بطاقات أخبار"
  },
  "description": {
    "en": "A centred title and lead, then photo cards with headlines and a button that scroll sideways.",
    "ar": "عنوان ومقدمة في الوسط، ثم بطاقات صور بعناوين وزر تتمرّر جانبياً."
  },
  "fields": [
    {
      "key": "title",
      "type": "shortText",
      "label": {
        "en": "Title",
        "ar": "العنوان"
      },
      "localized": true,
      "required": true,
      "aliases": [
        "heading",
        "headline",
        "titel",
        "name"
      ]
    },
    {
      "key": "description",
      "type": "longText",
      "label": {
        "en": "Text",
        "ar": "النص"
      },
      "localized": true,
      "aliases": [
        "body",
        "text",
        "lead",
        "subtitle",
        "intro",
        "content"
      ]
    },
    {
      "key": "buttonText",
      "type": "shortText",
      "label": {
        "en": "Button text",
        "ar": "نص الزر"
      },
      "localized": true,
      "aliases": [
        "ctaText",
        "button",
        "linkText"
      ]
    },
    {
      "key": "items",
      "type": "repeater",
      "label": {
        "en": "Cards",
        "ar": "البطاقات"
      },
      "aliases": [
        "cards",
        "stories",
        "news",
        "gallery",
        "list",
        "slides"
      ],
      "subFields": [
        {
          "key": "title",
          "type": "shortText",
          "label": {
            "en": "Headline",
            "ar": "العنوان"
          },
          "localized": true,
          "aliases": [
            "label",
            "name",
            "heading",
            "caption"
          ]
        },
        {
          "key": "image",
          "type": "image",
          "label": {
            "en": "Image",
            "ar": "الصورة"
          },
          "aliases": [
            "photo",
            "picture",
            "img",
            "cover",
            "media"
          ]
        },
        {
          "key": "link",
          "type": "url",
          "label": {
            "en": "Link",
            "ar": "الرابط"
          },
          "aliases": [
            "href",
            "url",
            "buttonLink"
          ]
        }
      ]
    }
  ],
  "version": "1.0.0",
  "placeholders": [
    {
      "token": "{{title}}",
      "field": "title",
      "type": "shortText",
      "label": {
        "en": "Title",
        "ar": "العنوان"
      }
    },
    {
      "token": "{{description}}",
      "field": "description",
      "type": "longText",
      "label": {
        "en": "Text",
        "ar": "النص"
      }
    },
    {
      "token": "{{buttonText}}",
      "field": "buttonText",
      "type": "shortText",
      "label": {
        "en": "Button text",
        "ar": "نص الزر"
      }
    },
    {
      "token": "{{items}}",
      "field": "items",
      "type": "repeater",
      "label": {
        "en": "Cards",
        "ar": "البطاقات"
      }
    },
    {
      "token": "{{#items}}",
      "field": "items",
      "type": "repeater",
      "role": "open"
    },
    {
      "token": "{{/items}}",
      "field": "items",
      "type": "repeater",
      "role": "close"
    },
    {
      "token": "{{title}}",
      "field": "items.title",
      "type": "shortText",
      "label": {
        "en": "Headline",
        "ar": "العنوان"
      },
      "scope": "items"
    },
    {
      "token": "{{image}}",
      "field": "items.image",
      "type": "image",
      "label": {
        "en": "Image",
        "ar": "الصورة"
      },
      "scope": "items"
    },
    {
      "token": "{{link}}",
      "field": "items.link",
      "type": "url",
      "label": {
        "en": "Link",
        "ar": "الرابط"
      },
      "scope": "items"
    }
  ]
}
