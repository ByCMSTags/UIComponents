      },
      "localized": true,
      "aliases": [
        "heading",
        "titel",
        "headline",
        "name",
        "label"
      ]
    },
    {
      "key": "description",
      "type": "longText",
      "label": {
        "en": "Description",
        "ar": "الوصف"
      },
      "localized": true,
      "aliases": [
        "text",
        "body",
        "content",
        "desc",
        "summary",
        "excerpt",
        "details",
        "subtitle",
        "lead",
        "leadleft",
        "intro",
        "paragraph"
      ]
    },
    {
      "key": "buttonText",
      "type": "shortText",
      "label": {
        "en": "Button text",
        "ar": "نص الزر"
      },
      "localized": true,
      "aliases": [
        "ctalabel",
        "cta",
        "ctaText",
        "buttonLabel",
        "btnText",
        "linkText",
        "linkLabel"
      ]
    },
    {
      "key": "buttonLink",
      "type": "url",
      "label": {
        "en": "Button link",
        "ar": "رابط الزر"
      },
      "aliases": [
        "ctaurl",
        "ctaLink",
        "buttonUrl",
        "btnLink",
        "url",
        "link",
        "href"
      ]
    }
  ],
  "sample": {
    "data": {
      "title": "Ready to start your website?",
      "description": "Tell us about your project and get a free plan within a day.",
      "buttonText": "Contact us",
      "buttonLink": "#"
