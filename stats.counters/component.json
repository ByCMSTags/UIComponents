{
  "id": "stats.counters",
  "category": "stats",
  "kind": "single",
  "name": {
    "en": "Counting numbers",
    "ar": "أرقام بعدّاد"
  },
  "description": {
    "en": "Large numbers that count up when they come into view, each with a label.",
    "ar": "أرقام كبيرة تعدّ عند ظهورها، لكل منها تسمية."
  },
  "fields": [
    {
      "key": "eyebrow",
      "type": "shortText",
      "label": {
        "en": "Small label",
        "ar": "التسمية الصغيرة"
      },
      "localized": true,
      "aliases": [
        "kicker",
        "tagline",
        "label"
      ]
    },
    {
      "key": "title",
      "type": "shortText",
      "label": {
        "en": "Title",
        "ar": "العنوان"
      },
      "localized": true,
      "aliases": [
        "heading",
        "headline",
        "name"
      ]
    },
    {
      "key": "items",
      "type": "repeater",
      "label": {
        "en": "Numbers",
        "ar": "الأرقام"
      },
      "aliases": [
        "stats",
        "numbers",
        "list"
      ],
      "subFields": [
        {
          "key": "value",
          "type": "number",
          "label": {
            "en": "Number",
            "ar": "الرقم"
          },
          "aliases": [
            "number",
            "count"
          ]
        },
        {
          "key": "suffix",
          "type": "shortText",
          "label": {
            "en": "After the number",
            "ar": "بعد الرقم"
          },
          "localized": true,
          "aliases": [
            "unit"
          ]
        },
        {
          "key": "label",
          "type": "shortText",
          "label": {
            "en": "Label",
            "ar": "التسمية"
          },
          "localized": true,
          "aliases": [
            "title",
            "name"
          ]
        },
        {
          "key": "description",
          "type": "longText",
          "label": {
            "en": "Text",
            "ar": "النص"
          },
          "localized": true,
          "aliases": [
            "body",
            "text",
            "lead",
            "subtitle",
            "intro",
            "content"
          ]
        }
      ]
    }
  ],
  "version": "1.0.0",
  "placeholders": [
    {
      "token": "{{eyebrow}}",
      "field": "eyebrow",
      "type": "shortText",
      "label": {
        "en": "Small label",
        "ar": "التسمية الصغيرة"
      }
    },
    {
      "token": "{{title}}",
      "field": "title",
      "type": "shortText",
      "label": {
        "en": "Title",
        "ar": "العنوان"
      }
    },
    {
      "token": "{{items}}",
      "field": "items",
      "type": "repeater",
      "label": {
        "en": "Numbers",
        "ar": "الأرقام"
      }
    },
    {
      "token": "{{#items}}",
      "field": "items",
      "type": "repeater",
      "role": "open"
    },
    {
      "token": "{{/items}}",
      "field": "items",
      "type": "repeater",
      "role": "close"
    },
    {
      "token": "{{value}}",
      "field": "items.value",
      "type": "number",
      "label": {
        "en": "Number",
        "ar": "الرقم"
      },
      "scope": "items"
    },
    {
      "token": "{{suffix}}",
      "field": "items.suffix",
      "type": "shortText",
      "label": {
        "en": "After the number",
        "ar": "بعد الرقم"
      },
      "scope": "items"
    },
    {
      "token": "{{label}}",
      "field": "items.label",
      "type": "shortText",
      "label": {
        "en": "Label",
        "ar": "التسمية"
      },
      "scope": "items"
    },
    {
      "token": "{{description}}",
      "field": "items.description",
      "type": "longText",
      "label": {
        "en": "Text",
        "ar": "النص"
      },
      "scope": "items"
    }
  ]
}
