  },
  "placeholders": [
    {
      "token": "{{heading}}",
      "field": "heading",
      "type": "shortText",
      "label": {
        "en": "Heading",
        "ar": "العنوان"
      }
    },
    {
      "token": "{{items}}",
      "field": "items",
      "type": "repeater",
      "label": {
        "en": "Columns",
        "ar": "الأعمدة"
      }
    },
    {
      "token": "{{#items}}",
      "field": "items",
      "type": "repeater",
      "role": "open"
    },
    {
      "token": "{{/items}}",
      "field": "items",
      "type": "repeater",
      "role": "close"
    },
    {
      "token": "{{title}}",
      "field": "items.title",
