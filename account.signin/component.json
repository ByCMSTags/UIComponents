        "ar": "العنوان"
      },
      "localized": true,
      "aliases": [
        "heading",
        "headline"
      ]
    },
    {
      "key": "text",
      "type": "longText",
      "label": {
        "en": "Text",
        "ar": "النص"
      },
      "localized": true,
      "aliases": [
        "intro",
        "description",
        "body"
      ]
    },
    {
      "key": "redirect",
      "type": "shortText",
      "label": {
        "en": "Page after signing in",
        "ar": "الصفحة بعد تسجيل الدخول"
