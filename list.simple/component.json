      }
    ]
  },
  "placeholders": [
    {
      "token": "{{title}}",
      "field": "title",
      "type": "shortText",
      "label": {
        "en": "Title",
        "ar": "العنوان"
      }
    },
    {
      "token": "{{description}}",
      "field": "description",
      "type": "longText",
      "label": {
        "en": "Short text",
        "ar": "نص قصير"
      }
    },
    {
      "token": "{{date}}",
      "field": "date",
      "type": "date",
      "label": {
        "en": "Date",
        "ar": "التاريخ"
      }
    },
    {
      "token": "{{link}}",
      "field": "link",
      "type": "url",
      "label": {
        "en": "Link",
        "ar": "الرابط"
      }
    }
