{
  "id": "gallery.cases",
  "category": "gallery",
  "kind": "single",
  "name": {
    "en": "Case studies carousel",
    "ar": "سلايدر دراسات حالة"
  },
  "description": {
    "en": "A filter list beside a large photo carousel of projects.",
    "ar": "قائمة تصفية بجانب سلايدر صور للمشاريع."
  },
  "fields": [
    {
      "key": "eyebrow",
      "type": "shortText",
      "label": {
        "en": "Small title",
        "ar": "عنوان صغير"
      },
      "localized": true,
      "aliases": [
        "tagline",
        "kicker",
        "subheading",
        "overline"
      ]
    },
    {
      "key": "title",
      "type": "shortText",
      "label": {
        "en": "Title",
        "ar": "العنوان"
      },
      "localized": true,
      "required": true,
      "aliases": [
        "heading",
        "headline",
        "titel",
        "name",
        "label"
      ]
    },
    {
      "key": "allLabel",
      "type": "shortText",
      "label": {
        "en": "All-projects label",
        "ar": "نص كل المشاريع"
      },
      "localized": true,
      "aliases": [
        "all",
        "allText"
      ]
    },
    {
      "key": "prevIcon",
      "type": "icon",
      "label": {
        "en": "Previous icon",
        "ar": "أيقونة السابق"
      },
      "placeholder": "fi-rr-angle-small-left"
    },
    {
      "key": "nextIcon",
      "type": "icon",
      "label": {
        "en": "Next icon",
        "ar": "أيقونة التالي"
      },
      "placeholder": "fi-rr-angle-small-right"
    },
    {
      "key": "items",
      "type": "repeater",
      "label": {
        "en": "Projects",
        "ar": "المشاريع"
      },
      "aliases": [
        "projects",
        "cases",
        "highlights",
        "gallery",
        "list",
        "cards",
        "entries",
        "rows"
      ],
      "subFields": [
        {
          "key": "title",
          "type": "shortText",
          "label": {
            "en": "Caption",
            "ar": "التسمية"
          },
          "localized": true,
          "aliases": [
            "titel",
            "heading",
            "headline",
            "name",
            "label",
            "caption"
          ]
        },
        {
          "key": "category",
          "type": "shortText",
          "label": {
            "en": "Category",
            "ar": "التصنيف"
          },
          "localized": true,
          "aliases": [
            "tag",
            "type",
            "topic",
            "group"
          ]
        },
        {
          "key": "image",
          "type": "image",
          "label": {
            "en": "Image",
            "ar": "الصورة"
          },
          "aliases": [
            "photo",
            "imges",
            "imegs",
            "images",
            "img",
            "picture",
            "cover",
            "media"
          ]
        },
        {
          "key": "link",
          "type": "url",
          "label": {
            "en": "Link",
            "ar": "الرابط"
          },
          "aliases": [
            "url",
            "href",
            "buttonLink"
          ]
        }
      ]
    }
  ],
  "version": "1.0.0",
  "placeholders": [
    {
      "token": "{{eyebrow}}",
      "field": "eyebrow",
      "type": "shortText",
      "label": {
        "en": "Small title",
        "ar": "عنوان صغير"
      }
    },
    {
      "token": "{{title}}",
      "field": "title",
      "type": "shortText",
      "label": {
        "en": "Title",
        "ar": "العنوان"
      }
    },
    {
      "token": "{{allLabel}}",
      "field": "allLabel",
      "type": "shortText",
      "label": {
        "en": "All-projects label",
        "ar": "نص كل المشاريع"
      }
    },
    {
      "token": "{{items}}",
      "field": "items",
      "type": "repeater",
      "label": {
        "en": "Projects",
        "ar": "المشاريع"
      }
    },
    {
      "token": "{{#items}}",
      "field": "items",
      "type": "repeater",
      "role": "open"
    },
    {
      "token": "{{/items}}",
      "field": "items",
      "type": "repeater",
      "role": "close"
    },
    {
      "token": "{{title}}",
      "field": "items.title",
      "type": "shortText",
      "label": {
        "en": "Caption",
        "ar": "التسمية"
      },
      "scope": "items"
    },
    {
      "token": "{{category}}",
      "field": "items.category",
      "type": "shortText",
      "label": {
        "en": "Category",
        "ar": "التصنيف"
      },
      "scope": "items"
    },
    {
      "token": "{{image}}",
      "field": "items.image",
      "type": "image",
      "label": {
        "en": "Image",
        "ar": "الصورة"
      },
      "scope": "items"
    },
    {
      "token": "{{link}}",
      "field": "items.link",
      "type": "url",
      "label": {
        "en": "Link",
        "ar": "الرابط"
      },
      "scope": "items"
    }
  ]
}
